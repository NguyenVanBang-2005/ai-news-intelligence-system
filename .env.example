APP_NAME=AI News Intelligence API
# development | testing | production
APP_ENV=development
# Host Python connects to 127.0.0.1 (not "localhost": on Windows it tries IPv6 first and stalls ~8s); Compose uses the db service instead.
DATABASE_URL=postgresql+psycopg://news:news@127.0.0.1:5432/news
POSTGRES_USER=news
POSTGRES_PASSWORD=news
POSTGRES_DB=news
POSTGRES_PORT=5432
API_PORT=8001
TZ=UTC
API_V1_PREFIX=/api/v1
REQUEST_TIMEOUT_SECONDS=15
MAX_FEED_ITEMS=50
# Max decoded RSS body size (bytes) and max stored content length (characters)
MAX_FEED_BYTES=2000000
MAX_ARTICLE_CONTENT_CHARS=20000

# AI configuration (AI_BATCH_SIZE must be >= AI_MIN_DOCUMENTS)
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
AI_MIN_DOCUMENTS=10
AI_BATCH_SIZE=500
DUPLICATE_SIMILARITY_THRESHOLD=0.92
# Outliers join the closest topic when at least this similar (0-1)
AI_OUTLIER_MIN_SIMILARITY=0.75
# A new topic reuses a stored topic's label when their centroids are at least this similar (0-1)
AI_TOPIC_MATCH_THRESHOLD=0.9
# Optional editorial categories as a JSON list; empty disables zero-shot topics
AI_ZEROSHOT_TOPICS=[]
AI_ZEROSHOT_MIN_SIMILARITY=0.7

# A pending/running AI job older than this many seconds no longer blocks new jobs
AI_JOB_TIMEOUT_SECONDS=3600

# LLM for summaries and answers (any OpenAI-compatible chat API).
# Local Gemma via Ollama (free): run `ollama pull <model>`, then keep these values.
# OpenAI: LLM_BASE_URL=https://api.openai.com/v1, LLM_MODEL=<model>, LLM_API_KEY=<key>
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=gemma4
LLM_API_KEY=ollama
LLM_TIMEOUT_SECONDS=60

# News search: sources per answer, minimum similarity (0-1), newest articles searched
ASK_MAX_SOURCES=5
ASK_MIN_SIMILARITY=0.8
ASK_MAX_CANDIDATES=2000
# Accept a link in /ai/ask (the server downloads it). false = search words only (demo)
ASK_ALLOW_LINKS=false

# Public search (POST /ai/search): requests per IP per minute (counted per server process)
# and maximum request body size in bytes
AI_SEARCH_RATE_PER_MINUTE=30
AI_SEARCH_MAX_BODY_BYTES=4096
# Public search only (ASK_MIN_SIMILARITY above is for /ai/ask): an article less similar
# than this (0-1) is shown only if it contains one of the search words. Keep it above
# the similarity of random words (about 0.3) so nonsense searches return nothing.
AI_SEARCH_MIN_SIMILARITY=0.5
# Load the search code and embedding model in the background at startup, so the first
# search does not wait ~30 s for it. Startup does not wait and does not fail if loading fails.
AI_PRELOAD_MODEL=true

# Download the article page when a source only gives a snippet shorter than this
INGESTION_FULL_TEXT=false
FULL_TEXT_MIN_CHARS=800

# News API sources (type "news_api"): free key from https://gnews.io
NEWS_API_KEY=
NEWS_API_BASE_URL=https://gnews.io/api/v4
NEWS_API_MAX_ARTICLES=10

# Article content extraction
ARTICLE_MAX_DOWNLOAD_BYTES=5000000
ARTICLE_MAX_REDIRECTS=3

# Token for write/costly endpoints (sources POST/DELETE, ingestion, AI process/ask),
# sent as the X-Admin-Token header. Empty: those endpoints return 503.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_TOKEN=
